{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:o017:semantic-wrapper:v1",
  "title": "O017 locale-neutral semantic and assessment wrapper v1",
  "description": "Enforceable record schema. Human-language text is stored only in explicit localized_text records. Renderer fragments are noncanonical locators.",
  "oneOf": [
    {"$ref": "#/$defs/learning_outcome"},
    {"$ref": "#/$defs/competency"},
    {"$ref": "#/$defs/assessment"},
    {"$ref": "#/$defs/rubric"},
    {"$ref": "#/$defs/criterion"},
    {"$ref": "#/$defs/submission"},
    {"$ref": "#/$defs/attempt"},
    {"$ref": "#/$defs/evaluator"},
    {"$ref": "#/$defs/evidence"},
    {"$ref": "#/$defs/result"},
    {"$ref": "#/$defs/credential_state"},
    {"$ref": "#/$defs/localized_text"}
  ],
  "$defs": {
    "semantic_id": {
      "type": "string",
      "pattern": "^O017-(?:LO|COMP|ASMT|RUBRIC|CRIT|SUBMISSION|ATTEMPT|EVALUATOR|EVIDENCE|RESULT|CREDENTIAL-STATE)-[A-Z0-9][A-Z0-9-]*$"
    },
    "localization_id": {
      "type": "string",
      "pattern": "^O017-L10N-ID-[A-Z0-9][A-Z0-9-]*$"
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^O017-ASMT-[A-Z0-9][A-Z0-9-]*$"
    },
    "rubric_id": {
      "type": "string",
      "pattern": "^O017-RUBRIC-[A-Z0-9][A-Z0-9-]*$"
    },
    "criterion_id": {
      "type": "string",
      "pattern": "^O017-CRIT-[A-Z0-9][A-Z0-9-]*$"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^O017-EVIDENCE-[A-Z0-9][A-Z0-9-]*$"
    },
    "evaluator_id": {
      "type": "string",
      "pattern": "^O017-EVALUATOR-[A-Z0-9][A-Z0-9-]*$"
    },
    "outcome_id": {
      "type": "string",
      "pattern": "^O017-LO-U[0-9]{2}-[0-9]{2}$"
    },
    "competency_id": {
      "type": "string",
      "pattern": "^O017-COMP-U[0-9]{2}$"
    },
    "unit_id": {
      "type": "string",
      "pattern": "^O017-U[0-9]{2}$"
    },
    "rights_id": {
      "type": "string",
      "enum": [
        "O017-RIGHTS-GENERATED-DATA",
        "O017-RIGHTS-ORIGINAL-CODE",
        "O017-RIGHTS-ORIGINAL-TEXT"
      ]
    },
    "locator": {
      "type": "object",
      "required": ["surface", "path", "fragment", "role", "canonical_identity"],
      "properties": {
        "surface": {
          "type": "string",
          "enum": ["source_qmd", "delivery_qmd", "rendered_html"]
        },
        "path": {
          "type": "string",
          "pattern": "^(?:source|delivery|build)/[^\\\\]+$"
        },
        "fragment": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "role": {
          "type": "string",
          "enum": ["outcomes_section", "assessment_prompt", "rubric", "calibration_exemplar", "form_template"]
        },
        "canonical_identity": {"const": false}
      },
      "additionalProperties": false
    },
    "semantic_base": {
      "type": "object",
      "required": ["schema", "entity_type", "id", "record_state", "localization_ids", "rights_id"],
      "properties": {
        "schema": {"const": "o017-semantic-wrapper-record-v1"},
        "entity_type": {
          "type": "string",
          "enum": ["learning_outcome", "competency", "assessment", "rubric", "criterion", "submission", "attempt", "evaluator", "evidence", "result", "credential_state"]
        },
        "id": {"$ref": "#/$defs/semantic_id"},
        "record_state": {
          "type": "string",
          "enum": ["active", "template", "role_definition", "state_definition"]
        },
        "localization_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/localization_id"}
        },
        "rights_id": {"$ref": "#/$defs/rights_id"},
        "locators": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/locator"}
        }
      }
    },
    "learning_outcome": {
      "allOf": [
        {"$ref": "#/$defs/semantic_base"},
        {
          "type": "object",
          "required": ["unit_id", "sequence", "competency_ids"],
          "properties": {
            "entity_type": {"const": "learning_outcome"},
            "record_state": {"const": "active"},
            "id": {"$ref": "#/$defs/outcome_id"},
            "unit_id": {"$ref": "#/$defs/unit_id"},
            "sequence": {"type": "integer", "minimum": 1},
            "competency_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/competency_id"}
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "competency": {
      "allOf": [
        {"$ref": "#/$defs/semantic_base"},
        {
          "type": "object",
          "required": ["unit_id", "domain_code", "outcome_ids", "assessment_ids"],
          "properties": {
            "entity_type": {"const": "competency"},
            "record_state": {"const": "active"},
            "id": {"$ref": "#/$defs/competency_id"},
            "unit_id": {"$ref": "#/$defs/unit_id"},
            "domain_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
            "outcome_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/outcome_id"}
            },
            "assessment_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/assessment_id"}
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "assessment": {
      "allOf": [
        {"$ref": "#/$defs/semantic_base"},
        {
          "type": "object",
          "required": ["assessment_kind", "authenticity", "required", "noncompensable", "completion_modes", "competency_ids", "outcome_ids", "rubric_id", "submission_template_id", "attempt_template_id", "result_template_id", "evaluator_role_ids", "evidence_spec_ids", "external_action_authority", "calibration_exemplar_required"],
          "properties": {
            "entity_type": {"const": "assessment"},
            "record_state": {"const": "active"},
            "id": {"$ref": "#/$defs/assessment_id"},
            "assessment_kind": {
              "type": "string",
              "enum": ["coursebook_unit_completion", "coursebook_capstone", "authentic_delivery"]
            },
            "authenticity": {
              "type": "string",
              "enum": ["bounded_local_or_synthetic", "real_source", "real_event", "two_person_independent", "real_source_independently_checked", "authorized_external_or_reviewed_local"]
            },
            "required": {"const": true},
            "noncompensable": {"const": true},
            "completion_modes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": ["coursebook_local", "authentic_direct", "community_transaction", "externally_reviewed_local"]
              }
            },
            "competency_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/competency_id"}
            },
            "outcome_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/outcome_id"}
            },
            "rubric_id": {"$ref": "#/$defs/rubric_id"},
            "submission_template_id": {
              "type": "string",
              "pattern": "^O017-SUBMISSION-TEMPLATE-[A-Z0-9][A-Z0-9-]*$"
            },
            "attempt_template_id": {
              "type": "string",
              "pattern": "^O017-ATTEMPT-TEMPLATE-[A-Z0-9][A-Z0-9-]*$"
            },
            "result_template_id": {
              "type": "string",
              "pattern": "^O017-RESULT-TEMPLATE-[A-Z0-9][A-Z0-9-]*$"
            },
            "evaluator_role_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/evaluator_id"}
            },
            "evidence_spec_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/evidence_id"}
            },
            "external_action_authority": {
              "type": "string",
              "enum": ["not_applicable", "separate_specific_human_authorization_required"]
            },
            "calibration_exemplar_required": {"type": "boolean"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "rubric_scoring": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode", "passing_value"],
          "properties": {
            "mode": {"const": "binary_all_required"},
            "passing_value": {"const": "met"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "scale", "minimum_total", "maximum_total", "required_full_score_criterion_ids", "mandatory_revision_overrides_total"],
          "properties": {
            "mode": {"const": "numeric_threshold_with_gates"},
            "scale": {"const": [0, 1, 2]},
            "minimum_total": {"type": "integer", "minimum": 1},
            "maximum_total": {"type": "integer", "minimum": 1},
            "required_full_score_criterion_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/criterion_id"}
            },
            "mandatory_revision_overrides_total": {"const": true}
          },
          "additionalProperties": false
        }
      ]
    },
    "rubric": {
      "allOf": [
        {"$ref": "#/$defs/semantic_base"},
        {
          "type": "object",
          "required": ["assessment_id", "criterion_ids", "scoring"],
          "properties": {
            "entity_type": {"const": "rubric"},
            "record_state": {"const": "active"},
            "id": {"$ref": "#/$defs/rubric_id"},
            "assessment_id": {"$ref": "#/$defs/assessment_id"},
            "criterion_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/criterion_id"}
            },
            "scoring": {"$ref": "#/$defs/rubric_scoring"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "criterion": {
      "allOf": [
        {"$ref": "#/$defs/semantic_base"},
        {
          "type": "object",
          "required": ["rubric_id", "sequence", "required", "scoring_mode", "passing_threshold", "evidence_spec_ids"],
          "properties": {
            "entity_type": {"const": "criterion"},
            "record_state": {"const": "active"},
            "id": {"$ref": "#/$defs/criterion_id"},
            "rubric_id": {"$ref": "#/$defs/rubric_id"},
            "sequence": {"type": "integer", "minimum": 1},
            "required": {"const": true},
            "scoring_mode": {"type": "string", "enum": ["binary", "numeric_0_2"]},
            "passing_threshold": {"oneOf": [{"const": "met"}, {"const": 2}]},
            "evidence_spec_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/evidence_id"}
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "submission": {
      "allOf": [
        {"$ref": "#/$defs/semantic_base"},
        {
          "type": "object",
          "required": ["assessment_id", "required_evidence_spec_ids", "submission_statuses", "preserves_prior_versions", "external_action_authority"],
          "properties": {
            "entity_type": {"const": "submission"},
            "record_state": {"const": "template"},
            "id": {"type": "string", "pattern": "^O017-SUBMISSION-TEMPLATE-[A-Z0-9][A-Z0-9-]*$"},
            "assessment_id": {"$ref": "#/$defs/assessment_id"},
            "required_evidence_spec_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/evidence_id"}
            },
            "submission_statuses": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "enum": ["draft", "prepared", "submitted", "withdrawn", "superseded"]}
            },
            "preserves_prior_versions": {"const": true},
            "external_action_authority": {
              "type": "string",
              "enum": ["not_applicable", "separate_specific_human_authorization_required"]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "attempt": {
      "allOf": [
        {"$ref": "#/$defs/semantic_base"},
        {
          "type": "object",
          "required": ["assessment_id", "submission_template_id", "evaluator_role_ids", "attempt_statuses", "requires_independent_evaluation", "preserves_attempt_history"],
          "properties": {
            "entity_type": {"const": "attempt"},
            "record_state": {"const": "template"},
            "id": {"type": "string", "pattern": "^O017-ATTEMPT-TEMPLATE-[A-Z0-9][A-Z0-9-]*$"},
            "assessment_id": {"$ref": "#/$defs/assessment_id"},
            "submission_template_id": {"type": "string", "pattern": "^O017-SUBMISSION-TEMPLATE-[A-Z0-9][A-Z0-9-]*$"},
            "evaluator_role_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/evaluator_id"}
            },
            "attempt_statuses": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "enum": ["not_started", "in_progress", "submitted_for_evaluation", "revision_required", "passed", "failed", "withheld"]}
            },
            "requires_independent_evaluation": {"type": "boolean"},
            "preserves_attempt_history": {"const": true}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "evaluator": {
      "allOf": [
        {"$ref": "#/$defs/semantic_base"},
        {
          "type": "object",
          "required": ["role_code", "independence", "privacy_preserving_id_allowed", "same_person_as_learner_allowed"],
          "properties": {
            "entity_type": {"const": "evaluator"},
            "record_state": {"const": "role_definition"},
            "id": {"$ref": "#/$defs/evaluator_id"},
            "role_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
            "independence": {"type": "string", "enum": ["course_assessor", "event_supervisor", "independent_from_learner", "authorized_external_event_verifier"]},
            "privacy_preserving_id_allowed": {"const": true},
            "same_person_as_learner_allowed": {"type": "boolean"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "evidence": {
      "allOf": [
        {"$ref": "#/$defs/semantic_base"},
        {
          "type": "object",
          "required": ["assessment_id", "criterion_id", "evidence_code", "evidence_scope", "required", "timestamp_required", "hash_required", "independent_check_required", "external_event_required", "accepted_media_types"],
          "properties": {
            "entity_type": {"const": "evidence"},
            "record_state": {"const": "template"},
            "id": {"$ref": "#/$defs/evidence_id"},
            "assessment_id": {"$ref": "#/$defs/assessment_id"},
            "criterion_id": {"$ref": "#/$defs/criterion_id"},
            "evidence_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
            "evidence_scope": {"type": "string", "enum": ["learner_submission", "independent_evaluation", "external_event", "delivery_calibration"]},
            "required": {"const": true},
            "timestamp_required": {"type": "boolean"},
            "hash_required": {"type": "boolean"},
            "independent_check_required": {"type": "boolean"},
            "external_event_required": {"type": "boolean"},
            "accepted_media_types": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"}
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "result": {
      "allOf": [
        {"$ref": "#/$defs/semantic_base"},
        {
          "type": "object",
          "required": ["assessment_id", "rubric_id", "attempt_template_id", "allowed_result_statuses", "preserves_unresolved_items", "requires_evaluator_identity"],
          "properties": {
            "entity_type": {"const": "result"},
            "record_state": {"const": "template"},
            "id": {"type": "string", "pattern": "^O017-RESULT-TEMPLATE-[A-Z0-9][A-Z0-9-]*$"},
            "assessment_id": {"$ref": "#/$defs/assessment_id"},
            "rubric_id": {"$ref": "#/$defs/rubric_id"},
            "attempt_template_id": {"type": "string", "pattern": "^O017-ATTEMPT-TEMPLATE-[A-Z0-9][A-Z0-9-]*$"},
            "allowed_result_statuses": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "enum": ["not_evaluated", "revise", "pass", "fail", "withheld", "prepared", "submitted", "acknowledged", "accepted", "merged", "published", "rejected", "withdrawn", "unknown", "externally_reviewed_local"]}
            },
            "preserves_unresolved_items": {"const": true},
            "requires_evaluator_identity": {"const": true}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "credential_state": {
      "allOf": [
        {"$ref": "#/$defs/semantic_base"},
        {
          "type": "object",
          "required": ["state_code", "terminal", "claims_external_participation", "required_assessment_ids", "required_result_statuses", "external_event_required", "predecessor_state_ids"],
          "properties": {
            "entity_type": {"const": "credential_state"},
            "record_state": {"const": "state_definition"},
            "id": {"type": "string", "pattern": "^O017-CREDENTIAL-STATE-[A-Z0-9][A-Z0-9-]*$"},
            "state_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
            "terminal": {"type": "boolean"},
            "claims_external_participation": {"type": "boolean"},
            "required_assessment_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/assessment_id"}
            },
            "required_result_statuses": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "enum": ["pass", "withheld", "submitted", "acknowledged", "accepted", "merged", "published", "rejected", "withdrawn", "externally_reviewed_local"]}
            },
            "external_event_required": {"type": "boolean"},
            "predecessor_state_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^O017-CREDENTIAL-STATE-[A-Z0-9][A-Z0-9-]*$"}
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "localized_text": {
      "type": "object",
      "required": ["schema", "entity_type", "id", "subject_id", "locale", "language", "field", "format", "text", "rights_id"],
      "properties": {
        "schema": {"const": "o017-localized-text-record-v1"},
        "entity_type": {"const": "localized_text"},
        "id": {"$ref": "#/$defs/localization_id"},
        "subject_id": {"$ref": "#/$defs/semantic_id"},
        "locale": {"const": "id-ID"},
        "language": {"const": "id"},
        "field": {
          "type": "string",
          "enum": ["label", "description", "instructions", "criterion_text", "pass_rule", "state_label"]
        },
        "format": {"type": "string", "enum": ["plain_text", "markdown_inline"]},
        "text": {"type": "string", "minLength": 1},
        "rights_id": {"const": "O017-RIGHTS-ORIGINAL-TEXT"}
      },
      "additionalProperties": false
    }
  }
}
